{
  "name": "thesis-desk",
  "productName": "Research Workspace",
  "version": "1.0.0",
  "private": true,
  "description": "Thesis Desk (Research Workspace): a local-first macOS research desk for venture investors. Every source you watch becomes cited evidence for your companies, firms and theses.",
  "keywords": [
    "venture-capital",
    "research",
    "electron",
    "local-first",
    "llm",
    "evidence",
    "knowledge-base",
    "macos",
    "sqlite"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JSai23/thesis-desk.git"
  },
  "homepage": "https://github.com/JSai23/thesis-desk#readme",
  "bugs": {
    "url": "https://github.com/JSai23/thesis-desk/issues"
  },
  "author": "JayaSai Somasundaram",
  "main": "app/out/main/index.js",
  "scripts": {
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "fixtures": "node fixtures/server/server.mjs",
    "fixtures:selftest": "cd prereq && node fixtures-selftest.mjs",
    "smoke": "node tests/run-suite.mjs smoke",
    "e2e:backend": "node tests/run-suite.mjs e2e-backend",
    "e2e:product": "node tests/run-suite.mjs e2e-product",
    "blind:knowledge": "node tests/blind/run.mjs knowledge",
    "blind:ux": "node tests/blind/run.mjs ux",
    "live:smoke": "node tests/run-suite.mjs live",
    "audit:static": "node tests/audit-static.mjs",
    "dist": "electron-vite build && electron-builder --mac dmg dir --publish never",
    "realdata": "node tests/run-suite.mjs realdata",
    "test:quick": "node tests/dev.mjs quick",
    "test:area": "node tests/dev.mjs area",
    "accept": "bash tests/accept.sh",
    "realdata:quality": "node tests/run-suite.mjs realdata-quality",
    "demo:record": "electron-vite build && playwright test -c tests/playwright.config.ts --project=demo"
  },
  "build": {
    "appId": "com.local.researchworkspace",
    "productName": "Research Workspace",
    "asar": true,
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**"
    ],
    "files": [
      "app/out/**",
      "app/resources/**",
      "package.json"
    ],
    "directories": {
      "output": "app/dist",
      "buildResources": "app/build"
    },
    "mac": {
      "target": [
        "dmg",
        "dir"
      ],
      "category": "public.app-category.productivity",
      "identity": "-",
      "hardenedRuntime": false,
      "icon": "app/build/icon.png"
    },
    "protocols": [
      {
        "name": "Research Workspace",
        "schemes": [
          "researchworkspace"
        ]
      }
    ]
  },
  "dependencies": {
    "@mozilla/readability": "0.6.0",
    "better-sqlite3": "13.0.3",
    "fast-xml-parser": "5.11.2",
    "imapflow": "2.1.2",
    "jsdom": "29.1.1",
    "mailparser": "3.9.32",
    "nodemailer": "10.0.13",
    "playwright-core": "1.63.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "robots-parser": "3.0.1",
    "ulid": "3.0.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electron/rebuild": "4.2.0",
    "@playwright/test": "1.63.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/jsdom": "30.0.0",
    "@types/mailparser": "3.9.0",
    "@types/node": "24.19.0",
    "@types/nodemailer": "8.0.2",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "gifenc": "1.0.3",
    "parse5": "8.0.1",
    "playwright": "1.63.0",
    "pngjs": "7.0.0",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  }
}
